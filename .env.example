# Telemetry fails closed. Enable providers one at a time after preview verification.
VITE_TELEMETRY_ENABLED=false

VITE_GA4_ENABLED=false
VITE_GA_MEASUREMENT_ID=

VITE_POSTHOG_ENABLED=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# The suffering.social GTM container must never publish advertising or identity tags.
VITE_GTM_ENABLED=false
VITE_GTM_CONTAINER_ID=

VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=

# Server-only Vercel build variables; never prefix these with VITE_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Server-only contact storage for the optional research-update form.
# Configure this in the hosting environment. Never expose it with VITE_*.
CONTACTS_API_KEY=
