{
  "name": "social-media-calculator",
  "version": "2.0.0",
  "description": "Research-based calculator for social media's economic impact",
  "type": "module",
  "main": "js/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "validate:growth": "node scripts/validate-growth.mjs dist",
    "verify:fast": "npm test -- --runInBand && npm run build && npm run validate:growth",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src/telemetry*.js src/sentry*.js src/*validator.test.js src/growth-contract.test.js src/operations-contract.test.js scripts/validate-growth.mjs scripts/verify-production-revision.mjs",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write js/**/*.js css/**/*.css",
    "bundle-analyze": "vite-bundle-analyzer dist",
    "lighthouse:ci": "lhci autorun --config=lighthouserc.json",
    "lighthouse:production": "lhci autorun --config=lighthouserc.production.json"
  },
  "dependencies": {
    "@sentry/browser": "^10.66.0",
    "chart.js": "^3.9.1",
    "nouislider": "^15.7.1",
    "posthog-js": "^1.404.1",
    "tippy.js": "^6.3.7"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/dom": "^8.19.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/user-event": "^14.4.3",
    "eslint": "^8.30.0",
    "eslint-config-prettier": "^8.5.0",
    "jest": "^29.3.1",
    "jest-environment-jsdom": "^29.3.1",
    "prettier": "^2.8.1",
    "tailwindcss": "^4.1.11",
    "vite": "^7.3.6",
    "vite-bundle-analyzer": "^0.7.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testPathIgnorePatterns": [
      "<rootDir>/tests/e2e/"
    ],
    "setupFilesAfterEnv": [
      "@testing-library/jest-dom"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/js/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!src/d3-distribution-sliders.js"
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2022": true,
      "jest": true
    },
    "extends": [
      "eslint:recommended",
      "prettier"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-console": "warn",
      "no-unused-vars": "error",
      "prefer-const": "error"
    }
  }
}
