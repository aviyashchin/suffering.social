{
  "name": "social-media-calculator",
  "version": "2.0.0",
  "description": "Research-based calculator for social media's economic impact",
  "type": "module",
  "main": "js/main.js",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "validate:growth": "node scripts/validate-growth.mjs dist",
    "verify:fast": "npm test -- --runInBand && npm run build && npm run validate:growth",
    "verify:release": "npm run test:coverage -- --runInBand && npm run lint && npm run build && npm run validate:growth && npm audit --omit=dev --audit-level=high && npm run test:e2e && npm run lighthouse:ci",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src scripts tests/e2e",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write js/**/*.js css/**/*.css",
    "bundle-analyze": "vite-bundle-analyzer dist",
    "lighthouse:ci": "lhci autorun --config=lighthouserc.json",
    "lighthouse:production": "lhci autorun --config=lighthouserc.production.json"
  },
  "dependencies": {
    "@sentry/browser": "^10.66.0",
    "nouislider": "^15.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/dom": "^8.19.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/user-event": "^14.4.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^2.8.1",
    "vite": "^7.3.6",
    "vite-bundle-analyzer": "^0.7.0"
  },
  "overrides": {
    "@lhci/cli": {
      "chrome-launcher": "1.2.1"
    },
    "@jest/reporters": {
      "glob": "13.0.6"
    },
    "jest-config": {
      "glob": "13.0.6"
    },
    "jest-runtime": {
      "glob": "13.0.6"
    },
    "babel-plugin-istanbul": {
      "test-exclude": {
        ".": "7.0.2",
        "glob": "13.0.6"
      }
    },
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testPathIgnorePatterns": [
      "<rootDir>/tests/e2e/"
    ],
    "setupFilesAfterEnv": [
      "@testing-library/jest-dom"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5"
  }
}
